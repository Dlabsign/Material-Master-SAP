*&---------------------------------------------------------------------*
*&      Form  SAVE_XLS
*&---------------------------------------------------------------------*
FORM SAVE_XLS.
  DATA: LV_FILENAME  TYPE STRING,
        LV_FILENAME2 TYPE RLGRAP-FILENAME,
        GV_PATH_INI  TYPE STRING,
        GV_PATH_SEL  TYPE STRING.

  CALL METHOD CL_GUI_FRONTEND_SERVICES=>DIRECTORY_BROWSE
    EXPORTING  INITIAL_FOLDER  = GV_PATH_INI
    CHANGING   SELECTED_FOLDER = GV_PATH_SEL
    EXCEPTIONS CNTL_ERROR      = 1 ERROR_NO_GUI = 2 OTHERS = 3.
  IF SY-SUBRC = 0.
    CALL METHOD CL_GUI_CFW=>FLUSH( ).
    IF NOT GV_PATH_SEL IS INITIAL.
      GV_PATH_INI = GV_PATH_SEL.
    ENDIF.
  ENDIF.

  CLEAR LV_FILENAME.
  LV_FILENAME  = GV_PATH_INI.
  LV_FILENAME2 = LV_FILENAME.
  CONCATENATE LV_FILENAME '/Error_' 'Material_Master ' '.xls' INTO LV_FILENAME.

  CALL FUNCTION 'GUI_DOWNLOAD'
    EXPORTING FILENAME             = LV_FILENAME
              FILETYPE             = 'ASC'
              WRITE_FIELD_SEPARATOR = 'X'
    TABLES    DATA_TAB             = ERR_TAB.
ENDFORM.                    " SAVE_XLS

*&=====================================================================*
*& FORM-FORM UNTUK DOWNLOAD TEMPLATE
*&=====================================================================*

*&---------------------------------------------------------------------*
*&      Form  DOWNLOAD_TEMPLATE
*&---------------------------------------------------------------------*
FORM DOWNLOAD_TEMPLATE.
  DATA: LV_HEADER   TYPE STRING,
        LV_PATH     TYPE STRING,
        LV_FILENAME TYPE STRING,
        LV_FULLPATH TYPE STRING,
        LV_ACTION   TYPE I,
        LT_DATA     TYPE STANDARD TABLE OF STRING.

  REFRESH LT_DATA.
  CLEAR: LV_HEADER, LV_FILENAME.

* Tentukan header & nama file sesuai radio button
  IF RLGORT IS NOT INITIAL.
    LV_FILENAME = 'Template_YMMI004_Storage_Location.xls'.
    LV_HEADER = 'Material Number'  && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Plant'            && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Storage Location'.

  ELSEIF RLGNUM IS NOT INITIAL.
    LV_FILENAME = 'Template_YMMI004_Warehouse_Number.xls'.
    LV_HEADER = 'Material Number'  && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Plant'            && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Warehouse Number'.

  ELSEIF RMATERIAL IS NOT INITIAL.
    LV_FILENAME = 'Template_YMMI004_Material_Master.xls'.
    PERFORM BUILD_HEADER_MATERIAL CHANGING LV_HEADER.

  ELSEIF RSBIN IS NOT INITIAL.
    LV_FILENAME = 'Template_YMMI004_Storage_Bin.xls'.
    LV_HEADER = 'Warehouse Number' && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Storage Type'     && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Storage Bin'      && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Storage Section'.

  ELSEIF RQUALITY IS NOT INITIAL.
    LV_FILENAME = 'Template_YMMI004_Quality_Management.xls'.
    PERFORM BUILD_HEADER_QUALITY CHANGING LV_HEADER.

  ELSEIF RKZWSM IS NOT INITIAL.
    LV_FILENAME = 'Template_YMMI004_Unit_of_Measure.xls'.
    LV_HEADER = 'Material Number'      && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'UoM Usage Indicator'  && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Characteristic Name'  && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Characteristic Value' && CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
             && 'Batch Specific UoM'.

  ELSE.
    MESSAGE 'Pilih salah satu mode upload terlebih dahulu.' TYPE 'I'.
    RETURN.
  ENDIF.

  APPEND LV_HEADER TO LT_DATA.

* Dialog simpan file
  CALL METHOD CL_GUI_FRONTEND_SERVICES=>FILE_SAVE_DIALOG
    EXPORTING
      DEFAULT_EXTENSION = 'XLS'
      DEFAULT_FILE_NAME = LV_FILENAME
      FILE_FILTER       = 'Excel Files (*.xls)|*.xls|All Files (*.*)|*.*'
    CHANGING
      FILENAME          = LV_FILENAME
      PATH              = LV_PATH
      FULLPATH          = LV_FULLPATH
      USER_ACTION       = LV_ACTION
    EXCEPTIONS
      CNTL_ERROR        = 1
      ERROR_NO_GUI      = 2
      OTHERS            = 3.

  IF SY-SUBRC <> 0 OR LV_ACTION = 1.  " 1 = user cancel
    RETURN.
  ENDIF.

  CALL FUNCTION 'GUI_DOWNLOAD'
    EXPORTING
      FILENAME                = LV_FULLPATH
      FILETYPE                = 'ASC'
      WRITE_FIELD_SEPARATOR   = CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB
    TABLES
      DATA_TAB                = LT_DATA
    EXCEPTIONS
      FILE_WRITE_ERROR        = 1
      NO_BATCH                = 2
      GUI_REFUSE_FILETRANSFER = 3
      OTHERS                  = 4.

  IF SY-SUBRC = 0.
    CONCATENATE 'Template berhasil didownload: ' LV_FULLPATH
      INTO LV_FULLPATH SEPARATED BY SPACE.
    MESSAGE LV_FULLPATH TYPE 'S'.
  ELSE.
    MESSAGE 'Gagal mendownload template.' TYPE 'E'.
  ENDIF.
ENDFORM.                    " DOWNLOAD_TEMPLATE

